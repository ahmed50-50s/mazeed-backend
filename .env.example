NODE_ENV=development
PORT=5000
# Interface to bind to (0.0.0.0 = all interfaces, needed on most hosts)
HOST=0.0.0.0

# Local:      mongodb://127.0.0.1:27017/quran_centers
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/quran_centers

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins ("*" allows all — dev only)
# Production example: https://mazeed-academy.com,https://www.mazeed-academy.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Largest file the admin can upload, in MB (stored in MongoDB GridFS)
MAX_UPLOAD_MB=50

# Disk folder for /api/v1/uploads files. In production point it outside the app folder
# (e.g. /home/<user>/mazeed-uploads) so a redeploy does not wipe the files.
UPLOAD_DIR=uploads

# Public base URL of this API, used to build absolute links to uploaded files
# Production: https://back.mazeed-academy.com
PUBLIC_URL=
