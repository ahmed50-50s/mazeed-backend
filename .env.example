NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/quran_centers

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins ("*" allows all — dev only)
# Production example: https://mazeed-frontend-zeta.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
